{
  "enabled": true,
  "driver": "ssd1309",
  "bus": "auto",
  "address": "0x3C",
  "probe_mode": "cmd",
  "audio_source": "ads1115",
  "audio_levels_file": "/dev/shm/service.vcr.recorder/audio_levels.json",
  "ads1115": {
    "bus": "auto",
    "address": "0x48",
