# EditorConfig helps maintain consistent coding styles across multiple developers
# and editors. http://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4

[*.{cpp,h,ino}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
