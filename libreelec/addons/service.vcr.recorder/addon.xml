<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.vcr.recorder"
       name="VCR Recorder Panel Service"
       version="0.1.0"
       provider-name="wolfg">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">VCR style hardware control for Kodi</summary>
    <description lang="en_GB">Reads button and RFID events, controls Kodi, updates OLED status.</description>
    <platform>linux</platform>
  </extension>
</addon>
